# tmux colors for kasumi.nvim
# Copy this file to ~/.config/tmux/kasumi.tmux, then add to your tmux.conf:
#   source-file ~/.config/tmux/kasumi.tmux
# Generated by scripts/build-extras.lua from lua/kasumi/palette.lua, do not edit

set -g mode-style "fg=#d3cdca,bg=#2c2c2c"

set -g message-style "fg=#dbaeaf,bg=#1d1d1d"
set -g message-command-style "fg=#dbaeaf,bg=#1d1d1d"

set -g pane-border-style "fg=#1e1d24"
set -g pane-active-border-style "fg=#dbaeaf"

set -g status "on"
set -g status-justify "left"
set -g status-style "fg=#d3cdca,bg=#121212"

set -g status-left-length "100"
set -g status-right-length "100"
set -g status-left-style NONE
set -g status-right-style NONE

# A rose block with dark text marks the session, as in the Neovim statusline
set -g status-left "#[fg=#181818,bg=#dbaeaf,bold] #S #[default] "
set -g status-right "#{prefix_highlight} #[fg=#b3c2c9,bg=#1e1d24] %Y-%m-%d  %I:%M %p #[fg=#181818,bg=#dbaeaf,bold] #h "
if-shell '[ "$(tmux show-option -gqv "clock-mode-style")" = "24" ]' {
  set -g status-right "#{prefix_highlight} #[fg=#b3c2c9,bg=#1e1d24] %Y-%m-%d  %H:%M #[fg=#181818,bg=#dbaeaf,bold] #h "
}

setw -g window-status-separator ""
setw -g window-status-style "NONE,fg=#818783,bg=#121212"
setw -g window-status-activity-style "underscore,fg=#dbbfaf,bg=#121212"
setw -g window-status-format " #I  #W #F "
setw -g window-status-current-format "#[fg=#dbaeaf,bg=#1e1d24,bold] #I  #W #F "

# tmux-plugins/tmux-prefix-highlight support
set -g @prefix_highlight_fg "#181818"
set -g @prefix_highlight_bg "#dbbfaf"
