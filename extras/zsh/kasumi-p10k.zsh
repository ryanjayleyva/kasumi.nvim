# kasumi.nvim colors for powerlevel10k
# Source this file after ~/.p10k.zsh in ~/.zshrc, then run: source ~/.zshrc
# Generated by scripts/build-extras.lua from lua/kasumi/palette.lua, do not edit

# p10k.zsh uses ANSI indexes 0-15, which follow the terminal palette, so override with exact hex

# The git segment is the exception. The default ~/.p10k.zsh draws it with
# my_git_formatter, which hardcodes its own colors, so the VCS lines below do not
# change it. To match, replace the colors in the first block of my_git_formatter
# in ~/.p10k.zsh, the one commented "green foreground", with:
#   local clean='%F{#babca7}' modified='%F{#9cbeba}'
#   local untracked='%F{#cac1c7}' conflicted='%F{#dbaeaf}'

# Exact hex colors, with the nearest color as a fallback without truecolor
[[ $COLORTERM == (truecolor|24bit) ]] || zmodload zsh/nearcolor 2>/dev/null

() {
	local foreground='#d3cdca' muted='#818783' rose='#dbaeaf' sage='#babca7' aqua='#9cbeba' mauve='#ccb6bf' peach='#dbbfaf' lavender='#cac1c7'

	typeset -g POWERLEVEL9K_PROMPT_CHAR_OK_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=$sage
	typeset -g POWERLEVEL9K_PROMPT_CHAR_ERROR_{VIINS,VICMD,VIVIS,VIOWR}_FOREGROUND=$rose

	typeset -g POWERLEVEL9K_DIR_FOREGROUND=$lavender
	typeset -g POWERLEVEL9K_DIR_ANCHOR_FOREGROUND=$lavender
	typeset -g POWERLEVEL9K_DIR_SHORTENED_FOREGROUND=$muted

	typeset -g POWERLEVEL9K_VCS_CLEAN_FOREGROUND=$sage
	typeset -g POWERLEVEL9K_VCS_UNTRACKED_FOREGROUND=$lavender
	typeset -g POWERLEVEL9K_VCS_MODIFIED_FOREGROUND=$aqua
	typeset -g POWERLEVEL9K_VCS_CONFLICTED_FOREGROUND=$rose

	typeset -g POWERLEVEL9K_STATUS_OK_FOREGROUND=$sage
	typeset -g POWERLEVEL9K_STATUS_OK_PIPE_FOREGROUND=$sage
	typeset -g POWERLEVEL9K_STATUS_ERROR_FOREGROUND=$rose
	typeset -g POWERLEVEL9K_STATUS_ERROR_SIGNAL_FOREGROUND=$rose
	typeset -g POWERLEVEL9K_STATUS_ERROR_PIPE_FOREGROUND=$rose
	typeset -g POWERLEVEL9K_COMMAND_EXECUTION_TIME_FOREGROUND=$peach
	typeset -g POWERLEVEL9K_BACKGROUND_JOBS_FOREGROUND=$rose
	typeset -g POWERLEVEL9K_TIME_FOREGROUND=$muted

	typeset -g POWERLEVEL9K_CONTEXT_FOREGROUND=$foreground
	typeset -g POWERLEVEL9K_CONTEXT_ROOT_FOREGROUND=$rose
	typeset -g POWERLEVEL9K_CONTEXT_REMOTE_FOREGROUND=$mauve
	typeset -g POWERLEVEL9K_CONTEXT_REMOTE_SUDO_FOREGROUND=$peach
}
