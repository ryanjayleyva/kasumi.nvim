# eza colors for kasumi.nvim
# Source this file from ~/.zshrc, then run: source ~/.zshrc
# Generated by scripts/build-extras.lua from lua/kasumi/palette.lua, do not edit

# Fields left out keep eza's defaults, which follow the terminal palette

# ur = User-read permission bit
# uw = User-write permission bit
# ux = User-execute permission bit for regular files
# ue = User-execute permission bit for other file kinds
# gr = Group-read permission bit
# gw = Group-write permission bit
# gx = Group-execute permission bit
# tr = Others-read permission bit
# tw = Others-write permission bit
# tx = Others-execute permission bit
# su = Setuid, setgid and sticky bits for files
# sf = Setuid, setgid and sticky bits for other file kinds
# oc = Permissions displayed as octal
# xa = Extended attribute indicator
# sn = Numbers of a file size
# sb = Units of a file size
# df = A device's major ID
# ds = A device's minor ID
# uu = A user that is you
# uR = A user that is root
# un = A user that is someone else
# gu = A group that you belong to
# gR = A group related to root
# gn = A group you are not a member of
# lc = Number of hard links
# lm = Number of hard links for a regular file with at least two
# ga = New flag in Git
# gm = Modified flag in Git
# gd = Deleted flag in Git
# gv = Renamed flag in Git
# gt = Modified metadata flag in Git
# gi = Ignored flag in Git
# gc = Conflicted flag in Git
# Gm = Main branch of repo
# Go = Other branch of repo
# Gc = Clean branch of repo
# Gd = Dirty branch of repo
# xx = Punctuation, including many background UI elements
# hd = Header row of a table
# da = A file's date
# in = A file's inode number
# bl = A file's number of blocks
# di = Directories
# ex = Executable files
# fi = Regular files
# ln = Symlinks
# lp = Path of a symlink
# or = Symlinks with no target
# cc = Escaped character in a filename
# pi = Named pipes
# so = Sockets
# bd = Block devices
# cd = Character devices
# sp = Special files
# mp = Mount point
# sc = Source code
# bu = Files used to build a project, like a Makefile
# do = Documents, like office suite documents or PDFs
# im = Images
# vi = Videos
# mu = Lossy music
# lo = Lossless music
# cr = Cryptography files, like a key or certificate
# co = Compressed files
# tm = Temporary files, like a text editor's backup
# cm = Compilation artifacts, like a Java class file

